{
  "name": "agent-flight-recorder",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-flight-recorder": "build/server/cli.js"
  },
  "description": "A local black box and forensic replay console for AI coding agents.",
  "homepage": "https://othmaneblial.github.io/Agent-Flight-Recorder/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OthmaneBlial/Agent-Flight-Recorder.git"
  },
  "bugs": {
    "url": "https://github.com/OthmaneBlial/Agent-Flight-Recorder/issues"
  },
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "agent-debugging",
    "ai-observability",
    "audit-trail",
    "observability",
    "local-first",
    "codex",
    "claude-code",
    "cursor",
    "opencode",
    "privacy-first"
  ],
  "files": [
    "build",
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:sandbox": "node scripts/dev.mjs",
    "dev:private": "node scripts/dev.mjs --private-data",
    "demo": "npm run build && node build/server/cli.js demo",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node build/server/cli.js serve",
    "scan": "tsx src/server/cli.ts scan",
    "doctor": "tsx src/server/cli.ts doctor",
    "hook": "tsx src/server/cli.ts hook",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs",
    "social-card": "node scripts/capture-social-card.mjs",
    "privacy:check": "node scripts/check-public-privacy.mjs",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test && npm run privacy:check && npm run build",
    "prepack": "npm run build && npm run privacy:check"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource-variable/syne": "^5.2.8",
    "@tanstack/react-virtual": "^3.14.10",
    "diff": "^9.0.0",
    "lucide-react": "^1.33.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.18.1"
  },
  "packageManager": "npm@11.12.1"
}
