# Agent Flight Recorder reads environment variables from the shell. It does not
# load this file automatically. Copy only the values you need into your shell.

# AFR_DATA_DIR=/absolute/path/to/.flight-recorder
AFR_REDACTION_MODE=mask
AFR_RAW_RETENTION_DAYS=30
AFR_SNAPSHOT_RETENTION_DAYS=90
AFR_SNAPSHOT_MAX_BYTES=2097152

# Optional on non-macOS systems. Generate a private 32-byte key and never commit it.
# AFR_STORE_KEY=

# Required only while exporting or importing an encrypted .afr bundle.
# AFR_BUNDLE_PASSPHRASE=
