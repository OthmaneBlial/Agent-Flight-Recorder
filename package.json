{
  "name": "agent-flight-recorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-flight-recorder": "build/server/cli.js"
  },
  "description": "Local-first observability and replay for AI coding agents.",
  "scripts": {
    "dev": "concurrently -k -n recorder,console -c yellow,cyan \"tsx watch src/server/cli.ts serve --dev\" \"vite\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node build/server/cli.js serve",
    "scan": "tsx src/server/cli.ts scan",
    "doctor": "tsx src/server/cli.ts doctor",
    "hook": "tsx src/server/cli.ts hook",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "verify": "npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource-variable/syne": "^5.2.8",
    "@tanstack/react-virtual": "^3.14.10",
    "diff": "^9.0.0",
    "lucide-react": "^1.33.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13"
  }
}
